{
  "app": {
    "name": "StatLine",
    "version": "1.0.0",
    "environment": "development"
  },
  "api": {
    "key": "YOUR_API_KEY_HERE",
    "baseUrl": "https://api.hypixel.net",
    "timeout": 5000
  },
  "discord": {
    "enabled": true,
    "token": "YOUR_DISCORD_BOT_TOKEN",
    "guildId": "YOUR_GUILD_ID"
  },
  "cache": {
    "enabled": true,
    "ttl": 60000,
    "maxEntries": 100
  },
  "rateLimit": {
    "enabled": true,
    "requestsPerMinute": 60
  },
  "features": {
    "bedwars": true
  }
}
